{
  "repository": "swift-library/swift-pdf",
  "version_file": "VERSION",
  "version_pattern": "^([^\\n]+)\\n?$",
  "changelog": "CHANGELOG.md",
  "check_command": "Scripts/check",
  "minimum_swift": "6.2",
  "ci": {
    "include": [
      {
        "name": "macos-15-swift-6.2",
        "runner": "macos-15",
        "xcode": "26.0.1",
        "command": "Scripts/prepare-ci-platforms\nScripts/check --compiler-check"
      },
      {
        "name": "macos-26-swift-6.3",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "Scripts/prepare-ci-platforms\nScripts/check --compiler-check"
      },
      {
        "name": "strict-format",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "Scripts/check --format-check"
      }
    ]
  },
  "platforms": {
    "iOS": [18, 26, 27],
    "macOS": [15, 26, 27],
    "visionOS": [2, 26, 27]
  }
}
