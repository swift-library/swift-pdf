{
  "compilers": [
    {
      "name": "macos-26-xcode-26.6",
      "runner": "macos-26",
      "xcode": "26.6"
    }
  ],
  "format": {
    "paths": [
      "Package.swift",
      "Sources",
      "Tests",
      "Examples/PDFViewer/Package.swift",
      "Examples/PDFViewer/Sources"
    ]
  },
  "platforms": {
    "apple": [
      {
        "name": "ios",
        "platform": "iOS",
        "scheme": "swift-pdf",
        "test": true
      },
      {
        "name": "visionos",
        "platform": "visionOS",
        "scheme": "swift-pdf"
      }
    ]
  },
  "docs": {
    "targets": [
      "PDF"
    ]
  },
  "commands": [
    {
      "name": "pdfviewer",
      "run": "swift build --package-path Examples/PDFViewer --force-resolved-versions"
    }
  ]
}
